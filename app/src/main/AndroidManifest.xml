<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StabilityTool"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StabilityTool">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- 用于任务调度器泄漏测试的空JobService -->
        <service
            android:name=".service.DummyJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
            
        <!-- ANR测试相关组件 -->
        <!-- 用于Service ANR测试的慢服务 -->
        <service
            android:name=".service.AnrSimulator$SlowService"
            android:exported="false" />
            
        <!-- 用于ContentProvider ANR测试的慢内容提供者 -->
        <provider
            android:name=".service.AnrSimulator$SlowContentProvider"
            android:authorities="com.ovea_y.stabilitytool.slowprovider"
            android:exported="false" />

        <!-- 必须用静态广播，动态注册的接收器 当应用在前台时，系统可能不会严格监控其超时（仅触发普通主线程阻塞的 ANR）-->
        <!-- 静态注册的接收器：在 AndroidManifest.xml 中声明，系统会强制监控其执行时间。 -->
        <receiver
            android:name="com.ovea_y.stabilitytool.service.AnrSimulator$SlowBroadcastReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.ovea_y.stabilitytool.SLOW_BROADCAST" />
            </intent-filter>
        </receiver>

        <provider
            android:name="com.ovea_y.stabilitytool.service.AnrSimulator$SlowContentProvider"
            android:authorities="com.ovea_y.stabilitytool.slowprovider"
            android:process=":remote"
            android:exported="true"
        />
    </application>

</manifest>